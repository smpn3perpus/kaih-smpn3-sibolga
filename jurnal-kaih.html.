function tampilFeedback(row) {

  const box =
    document.getElementById(
      "feedback"
    );

  const isi =
    document.getElementById(
      "isiFeedback"
    );


  if (
    !row ||
    (
      !row.respons_guru &&
      !row.komentar_guru
    )
  ) {

    box.style.display =
      "none";

    return;

  }


  let html = "";


  if (row.respons_guru) {

    html += `
      <p>
        <strong>Respons:</strong>
        ${aman(row.respons_guru)}
      </p>
    `;

  }


  if (row.komentar_guru) {

    html += `
      <p>
        <strong>Komentar Guru:</strong><br>
        ${aman(row.komentar_guru)}
      </p>
    `;

  }


  isi.innerHTML =
    html;

  box.style.display =
    "block";

}


// =====================================================
// AMAN HTML
// =====================================================

function aman(nilai) {

  if (
    nilai === null ||
    nilai === undefined
  ) {

    return "";

  }

  return String(nilai)
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}


