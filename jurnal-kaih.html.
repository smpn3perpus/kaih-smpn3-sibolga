<script>

// =====================================================
// SUPABASE
// =====================================================

const SUPABASE_URL =
  "https://nnnvgbajiqlqrsaygxme.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_dHIoPw_gfvud74PH4UCp2w_yGzl9oDy";

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


// =====================================================
// VARIABEL
// =====================================================

let userLogin = null;
let siswaLogin = null;


// =====================================================
// TANGGAL HARI INI
// =====================================================

function tanggalHariIni() {

  const sekarang = new Date();

  const tahun =
    sekarang.getFullYear();

  const bulan =
    String(
      sekarang.getMonth() + 1
    ).padStart(2, "0");

  const hari =
    String(
      sekarang.getDate()
    ).padStart(2, "0");

  return `${tahun}-${bulan}-${hari}`;
}


// =====================================================
// PESAN
// =====================================================

function tampilPesan(
  teks,
  sukses = false
) {

  const box =
    document.getElementById("pesan");

  box.textContent = teks;

  box.className =
    "pesan " +
    (
      sukses
      ? "sukses"
      : "gagal"
    );

  box.style.display = "block";

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}


// =====================================================
// RADIO
// =====================================================

function ambilRadio(name) {

  const pilihan =
    document.querySelector(
      `input[name="${name}"]:checked`
    );

  return pilihan
    ? pilihan.value
    : null;
}


// =====================================================
// CEK LOGIN
// =====================================================

async function cekLogin() {

  try {

    const hasil =
      await supabaseClient.auth.getUser();

    if (hasil.error) {

      console.error(
        hasil.error
      );

      window.location.href =
        "login-siswa.html";

      return;

    }

    const user =
      hasil.data.user;

    if (!user) {

      window.location.href =
        "login-siswa.html";

      return;

    }

    userLogin = user;

    await ambilDataSiswa();

  }
  catch(error) {

    console.error(error);

    tampilPesan(
      "❌ Gagal memeriksa login: " +
      error.message
    );

  }

}


// =====================================================
// AMBIL DATA SISWA
// =====================================================

async function ambilDataSiswa() {

  const hasil =
    await supabaseClient
      .from("siswa")
      .select("*")
      .eq(
        "auth_user_id",
        userLogin.id
      )
      .maybeSingle();


  if (hasil.error) {

    console.error(
      hasil.error
    );

    // Jika auth_user_id belum terisi,
    // gunakan NISN sebagai cadangan.

    if (userLogin.email) {

      const nisn =
        userLogin.email
          .split("@")[0];

      const cadangan =
        await supabaseClient
          .from("siswa")
          .select("*")
          .eq(
            "nisn",
            nisn
          )
          .maybeSingle();

      if (
        !cadangan.error &&
        cadangan.data
      ) {

        siswaLogin =
          cadangan.data;

      }

    }

  }
  else {

    siswaLogin =
      hasil.data;

  }


  if (!siswaLogin) {

    document.getElementById(
      "loading"
    ).innerHTML = `
      ❌ Data siswa tidak ditemukan.
      <br><br>
      Pastikan akun login sudah terhubung
      dengan data pada tabel siswa.
    `;

    return;

  }


  // =========================================
  // TAMPIL DATA SISWA
  // =========================================

  document.getElementById(
    "namaSiswa"
  ).textContent =
    siswaLogin.nama || "-";

  document.getElementById(
    "nisnSiswa"
  ).textContent =
    siswaLogin.nisn || "-";


  // =========================================
  // KELAS
  // =========================================

  if (siswaLogin.kelas_id) {

    const kelas =
      await supabaseClient
        .from("kelas")
        .select("*")
        .eq(
          "id",
          siswaLogin.kelas_id
        )
        .maybeSingle();

    if (kelas.data) {

      document.getElementById(
        "kelasSiswa"
      ).textContent =
        kelas.data.nama ||
        kelas.data.nama_kelas ||
        kelas.data.name ||
        "-";

    }

  }


  // =========================================
  // GURU WALI
  // =========================================

  if (siswaLogin.guru_wali_id) {

    const guru =
      await supabaseClient
        .from("guru")
        .select("*")
        .eq(
          "id",
          siswaLogin.guru_wali_id
        )
        .maybeSingle();

    if (guru.data) {

      document.getElementById(
        "guruWaliSiswa"
      ).textContent =
        guru.data.nama ||
        guru.data.nama_guru ||
        guru.data.name ||
        "-";

    }

  }


  // =========================================
  // TANGGAL
  // =========================================

  document.getElementById(
    "tanggal"
  ).value =
    tanggalHariIni();


  document.getElementById(
    "loading"
  ).style.display =
    "none";


  document.getElementById(
    "formJurnal"
  ).style.display =
    "block";


  // =========================================
  // MUAT JURNAL HARI INI
  // =========================================

  await muatJurnal();

}


// =====================================================
// MUAT JURNAL
// =====================================================

async function muatJurnal() {

  if (!siswaLogin) {
    return;
  }

  const tanggal =
    document.getElementById(
      "tanggal"
    ).value;

  if (!tanggal) {
    return;
  }


  const hasil =
    await supabaseClient
      .from("jurnal_7_kaih")
      .select("*")
      .eq(
        "siswa_id",
        siswaLogin.id
      )
      .eq(
        "tanggal",
        tanggal
      )
      .maybeSingle();


  if (hasil.error) {

    console.error(
      "Gagal mengambil jurnal:",
      hasil.error
    );

    return;
  }


  const row =
    hasil.data;


  if (!row) {

    kosongkanForm();

    tampilFeedback(null);

    return;

  }


  // =========================================
  // ISI FORM DARI DATABASE
  // =========================================

  setValue(
    "jam_bangun",
    row.jam_bangun
  );

  setValue(
    "menu_sarapan",
    row.menu_sarapan
  );

  setValue(
    "menu_siang",
    row.menu_siang
  );

  setValue(
    "menu_malam",
    row.menu_malam
  );

  setValue(
    "menu_sahur",
    row.menu_sahur
  );

  setValue(
    "menu_berbuka",
    row.menu_berbuka
  );

  setValue(
    "jenis_olahraga",
    row.jenis_olahraga
  );

  setValue(
    "durasi_olahraga",
    row.durasi_olahraga
  );

  setValue(
    "alasan_olahraga",
    row.alasan_olahraga
  );

  setValue(
    "jenis_bermasyarakat",
    row.jenis_bermasyarakat
  );

  setValue(
    "alasan_bermasyarakat",
    row.alasan_bermasyarakat
  );

  setValue(
    "materi_belajar",
    row.materi_belajar
  );

  setValue(
    "durasi_belajar",
    row.durasi_belajar
  );

  setValue(
    "alasan_belajar",
    row.alasan_belajar
  );

  setValue(
    "jenis_ibadah",
    row.jenis_ibadah
  );

  setValue(
    "alasan_ibadah",
    row.alasan_ibadah
  );

  setValue(
    "jam_tidur",
    row.jam_tidur
  );


  setRadio(
    "puasa",
    row.puasa
  );

  setRadio(
    "olahraga",
    row.olahraga
  );

  setRadio(
    "bermasyarakat",
    row.bermasyarakat
  );

  setRadio(
    "belajar_malam",
    row.belajar_malam
  );

  setRadio(
    "ibadah",
    row.ibadah
  );


  // Feedback guru

  tampilFeedback(row);

}


// =====================================================
// SET VALUE
// =====================================================

function setValue(
  id,
  nilai
) {

  const el =
    document.getElementById(id);

  if (el) {

    el.value =
      nilai ??
      "";

  }

}


// =====================================================
// SET RADIO
// =====================================================

function setRadio(
  name,
  nilai
) {

  if (!nilai) {
    return;
  }

  const radio =
    document.querySelector(
      `input[name="${name}"][value="${nilai}"]`
    );

  if (radio) {

    radio.checked =
      true;

  }

}


// =====================================================
// KOSONGKAN FORM
// =====================================================

function kosongkanForm() {

  const inputs =
    document.querySelectorAll(
      "#formJurnal input, #formJurnal textarea"
    );

  inputs.forEach(
    function(input) {

      if (
        input.type === "radio"
      ) {

        input.checked =
          false;

      }
      else {

        input.value =
          "";

      }

    }
  );

}


