    await supabaseClient
      .from("jurnal_7_kaih")
      .select("id")
      .eq(
        "siswa_id",
        siswaLogin.id
      )
      .eq(
        "tanggal",
        tanggal
      )
      .maybeSingle();


  if (cek.error) {

    tampilPesan(
